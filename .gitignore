data/processed_fixtures/
data/fixtures/
logs/*
!logs/.gitkeep

# Source PDFs: official RBI documents are downloaded locally, not committed
data/raw/*.pdf
data/raw/*.PDF
data/raw/manifest.json

# Editors / OS
.vscode/
.idea/
.DS_Store
