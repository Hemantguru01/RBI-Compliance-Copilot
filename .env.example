# Copy to .env and fill in. Never commit .env.

# --- LLM ---------------------------------------------------------------
# "anthropic" (Claude, needs ANTHROPIC_API_KEY) or "extractive" (offline:
# verbatim source sentences, no LLM). If the key is missing the app falls
# back to extractive automatically and says so in /health and the UI.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (lower = cheaper/faster)
LLM_EFFORT=medium
LLM_MAX_TOKENS=4000
LLM_ENABLE_REFUSAL_FALLBACK=true

# --- Embeddings / retrieval ----------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu
TOP_K=5
CANDIDATE_K=30
SIMILARITY_THRESHOLD=0.45
ENABLE_HYBRID_SEARCH=true
ENABLE_RERANKER=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_THRESHOLD=-6.0

# --- Chunking (changing these requires POST /reindex) ---------------------
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
MIN_CHUNK_CHARS=80

# --- Paths & server -------------------------------------------------------
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
VECTOR_STORE_DIR=vector_store
LOG_DIR=logs
API_HOST=127.0.0.1
API_PORT=8000
# Used by the Streamlit app to reach the API
API_BASE_URL=http://127.0.0.1:8000
LOG_LEVEL=INFO
