{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend (FastAPI :8000)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Frontend (Streamlit :8501)",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "frontend/streamlit_app.py", "--server.port", "8501", "--server.headless", "false"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "Pytest (all tests)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "▶ Run RBI Compliance Copilot (Backend + Frontend)",
      "configurations": ["Backend (FastAPI :8000)", "Frontend (Streamlit :8501)"],
      "stopAll": true
    }
  ]
}
